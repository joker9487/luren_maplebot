# 複製成 .env 再改（.env 不進 Git）
# OPENAI_API_KEY 建議設在系統環境變數，不要寫進這裡

# Ollama（本機；embedding 一律用它）
# 用 Docker 跑時 docker-compose.yml 會自動改成 http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3
# bge-m3 閒置多久才從記憶體卸載（Ollama 預設 5 分鐘，卸載後第一題會慢一兩秒；只佔約 1.2GB）
EMBED_KEEP_ALIVE=24h

# 檢索
SCORE_THRESHOLD=0.45
TOP_K=4

# 知識庫與向量庫（data/ 放真資料；試跑範例可改成 data/examples）
DATA_DIR=data
CHROMA_DIR=storage/chroma
CHROMA_COLLECTION=maplestar

# ---- 回答模型：ollama | openai ----
# 建議：OpenAI gpt-5-nano（壓測 100 人同時各問 3 題，300 題全部成功，首字 P50 約 10 秒）
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-nano
# gpt-5 系列用；有些新版模型不收 minimal，要改成 none 或 low
OPENAI_REASONING_EFFORT=minimal
# OPENAI_API_KEY=   ← 沒設系統環境變數才寫在這

# 改用本機模型時：
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# 並把下面的 MAX_CONCURRENT 改成 3

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
# Ollama 的 context 長度（資料 + 問題 + 回答要塞得下；預設值偏小會默默截掉）
OLLAMA_NUM_CTX=8192

# 紀錄與 prompt
DB_PATH=storage/qa.db
PROMPT_FILE=prompts/answer_v2.txt

# 環境：development | production（production 會關掉 /docs、/redoc、/openapi.json）
# 用 Docker 跑時 docker-compose.yml 會自動設成 production
ENV=development

# 限流（IP 只存在記憶體，不寫入任何檔案）
COOLDOWN_SECONDS=5
HOURLY_LIMIT=30
# 全站每日上限，台灣時間每天 0 點歸零
DAILY_LIMIT=1000

# 同時生成上限：最多幾題同時在跑，排隊超過幾秒回 503
# OpenAI：30 / 30；本機 Ollama：3 / 20（顯卡只有 8GB）
# QUEUE_TIMEOUT 不要超過 90：經過 Cloudflare 時，100 秒內沒有回應會直接回錯誤（524）
MAX_CONCURRENT=30
QUEUE_TIMEOUT=30

# 相同問題快取：同樣的問題、同樣的資料，幾小時內直接回上次的答案（不呼叫模型）
# 資料改了、換 prompt 或模型會自動失效；被按 👎 的答案不會再被拿來用
CACHE_ENABLED=true
CACHE_TTL_HOURS=72

# 許願（玩家送「想問的問題」）的限流，跟問答分開算
SUGGEST_COOLDOWN_SECONDS=3
SUGGEST_HOURLY_LIMIT=5
SUGGEST_DAILY_LIMIT=500

# Cloudflare Tunnel（正式網域用；臨時網址不需要）
# 1. Cloudflare → Zero Trust → Networks → Tunnels → 建立（Cloudflared）
# 2. 安裝方式選 Docker，把 --token 後面那串貼到這裡（像密碼一樣保管，不要外流）
# 3. 新增路由（Public Hostname）：服務 URL 填 http://app:8000（是 http、是 app 不是 localhost）
# 4. docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Docker 對本機開的 port（8000 被占用時改）
APP_PORT=8000
